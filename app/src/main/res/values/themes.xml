<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Calculator theme: no action bar, black background, immersive -->
    <style name="Theme.Morphus" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">#FF000000</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
    </style>

    <style name="Theme.Morphus.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.Morphus.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
