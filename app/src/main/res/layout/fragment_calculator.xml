<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    tools:context=".ui.CalculatorFragment">

    <!-- Display Area (also hidden trigger zone) -->
    <LinearLayout
        android:id="@+id/display_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:gravity="end|bottom"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <!-- Expression (secondary line) -->
        <TextView
            android:id="@+id/tv_expression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:gravity="end"
            android:maxLines="2"
            android:text=""
            android:textColor="#80FFFFFF"
            android:textSize="24sp" />

        <!-- Result (primary line) -->
        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:gravity="end"
            android:maxLines="1"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="56sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="24sp"
            android:autoSizeMaxTextSize="56sp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF" />

    <!-- Button Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:columnCount="4"
        android:rowCount="5"
        android:padding="4dp">

        <!-- Row 1: AC  ⌫  %  ÷ -->
        <Button
            android:id="@+id/btn_clear"
            style="@style/CalcButton.Function"
            android:text="AC" />

        <ImageButton
            android:id="@+id/btn_backspace"
            style="@style/CalcButton.Function"
            android:src="@drawable/ic_backspace"
            android:contentDescription="Backspace"
            android:scaleType="center" />

        <Button
            android:id="@+id/btn_percent"
            style="@style/CalcButton.Function"
            android:text="%" />

        <Button
            android:id="@+id/btn_divide"
            style="@style/CalcButton.Operator"
            android:text="÷" />

        <!-- Row 2: 7  8  9  × -->
        <Button
            android:id="@+id/btn_7"
            style="@style/CalcButton.Number"
            android:text="7" />

        <Button
            android:id="@+id/btn_8"
            style="@style/CalcButton.Number"
            android:text="8" />

        <Button
            android:id="@+id/btn_9"
            style="@style/CalcButton.Number"
            android:text="9" />

        <Button
            android:id="@+id/btn_multiply"
            style="@style/CalcButton.Operator"
            android:text="×" />

        <!-- Row 3: 4  5  6  − -->
        <Button
            android:id="@+id/btn_4"
            style="@style/CalcButton.Number"
            android:text="4" />

        <Button
            android:id="@+id/btn_5"
            style="@style/CalcButton.Number"
            android:text="5" />

        <Button
            android:id="@+id/btn_6"
            style="@style/CalcButton.Number"
            android:text="6" />

        <Button
            android:id="@+id/btn_subtract"
            style="@style/CalcButton.Operator"
            android:text="−" />

        <!-- Row 4: 1  2  3  + -->
        <Button
            android:id="@+id/btn_1"
            style="@style/CalcButton.Number"
            android:text="1" />

        <Button
            android:id="@+id/btn_2"
            style="@style/CalcButton.Number"
            android:text="2" />

        <Button
            android:id="@+id/btn_3"
            style="@style/CalcButton.Number"
            android:text="3" />

        <Button
            android:id="@+id/btn_add"
            style="@style/CalcButton.Operator"
            android:text="+" />

        <!-- Row 5: +/−  0  .  = -->
        <Button
            android:id="@+id/btn_negate"
            style="@style/CalcButton.Number"
            android:text="+/−" />

        <Button
            android:id="@+id/btn_0"
            style="@style/CalcButton.Number"
            android:text="0" />

        <Button
            android:id="@+id/btn_decimal"
            style="@style/CalcButton.Number"
            android:text="." />

        <Button
            android:id="@+id/btn_equals"
            style="@style/CalcButton.Equals"
            android:text="=" />

    </GridLayout>

</LinearLayout>
